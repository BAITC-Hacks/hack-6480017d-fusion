# Только сервер. Скопируйте в .env и заполните ключи; настройки загружаются при старте.
# Не сохранять ключи в frontend, VITE_ переменных, Git или логах.
OPENAI_API_KEY=
OPENAI_MODEL=
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Необязательная рецензия; по текущему сценарию выключена.
NVIDIA_ENABLED=false
